# ============================================================
# OpenFOAM — Ignore all cases and STL files
# ============================================================

# All generated cases (ignore contents, keep folder)
cases/*
!cases/.gitkeep

# All STL geometry files (ignore contents, keep folder and sample demo STL)
stl/*
!stl/.gitkeep
!stl/geometry.stl
!stl/geometry.STL
*.stl
*.STL
!stl/geometry.stl
!stl/geometry.STL

# Configuration files (ignore custom configs, keep default template)
configs/*
!configs/config.json

# ============================================================
# OpenFOAM generated files (safety net)
# ============================================================

# Mesh
**/constant/polyMesh/
**/constant/extendedFeatureEdgeMesh/
**/constant/triSurface/*.eMesh

# Time step results
**/[1-9]*/
**/[1-9][0-9]*/
**/[1-9][0-9][0-9]*/
**/[1-9][0-9][0-9][0-9]*/
**/[1-9][0-9][0-9][0-9][0-9]*/

# Processor directories
**/processor*/

# Log files
**/log.*

# Post-processing output
**/postProcessing/

# SLURM output logs
**/*_*.log

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# ============================================================
# Node / front-end tests
# ============================================================
node_modules/
npm-debug.log*
.npm/

# ============================================================
# IDE / Editor / AI Agents
# ============================================================
.vscode/
.idea/
.agents/
*.swp
*.swo
*~
.DS_Store

# ============================================================
# OS
# ============================================================
Thumbs.db
.DS_Store
