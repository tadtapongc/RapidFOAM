FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
scale   1;

vertices
(
    (0.0 0.0 -24.0)
    (5.0 0.0 -24.0)
    (5.0 5.0 -24.0)
    (0.0 5.0 -24.0)
    (0.0 0.0 15.0)
    (5.0 0.0 15.0)
    (5.0 5.0 15.0)
    (0.0 5.0 15.0)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (50 50 390) simpleGrading (1 1 1)
);

edges ();

boundary
(
    symmetry
    {
        type symmetry;
        faces ( (0 4 7 3) );
    }
    farField
    {
        type patch;
        faces ( (1 2 6 5) (2 3 7 6) );
    }
    ground
    {
        type wall;
        faces ( (0 1 5 4) );
    }
    outlet
    {
        type patch;
        faces ( (0 3 2 1) );
    }
    inlet
    {
        type patch;
        faces ( (4 5 6 7) );
    }
);

mergePatchPairs ();


// ************************************************************************* //
